# ==========================================
# SERVD - AI RECIPE PLATFORM ENVIRONMENT CONFIGURATION
# Made with ❤️ Romsha Wadhwa
# ==========================================

# ------------------------------------------
# FRONTEND CONFIGURATION (Next.js)
# ------------------------------------------

# Strapi Headless CMS Backend URL & API Token
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_full_access_api_token_here

# AI Recipe Engine (Google Gemini AI API Key)
# Get key from https://aistudio.google.com/
GEMINI_API_KEY=your_google_gemini_api_key_here

# Image Provider (Unsplash API Access Key for Recipe Photos)
# Get key from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Security & Rate Limiting (Arcjet)
# Get key from https://arcjet.com
ARCJET_KEY=your_arcjet_api_key_here

# Authentication (Clerk Auth Keys)
# Get keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------
# BACKEND CONFIGURATION (Strapi CMS v5)
# ------------------------------------------
HOST=0.0.0.0
PORT=1337
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=toBeModifiedSalt
ADMIN_JWT_SECRET=toBeModifiedAdminSecret
TRANSFER_TOKEN_SALT=toBeModifiedTransferSalt
JWT_SECRET=toBeModifiedJwtSecret
ENCRYPTION_KEY=toBeModifiedEncryptionKey

# Database Connection (Neon Serverless PostgreSQL)
# Example: postgres://user:password@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_CLIENT=postgres
DATABASE_URL=postgres://username:password@ep-name.region.aws.neon.tech/dbname?sslmode=require
